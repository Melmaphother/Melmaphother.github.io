{
  "about": "<section id=\"about\">\n            <h2>\n                <span class=\"en-text\">About Me</span>\n                <span class=\"zh-text\">关于我</span>\n            </h2>\n            <p class=\"en-text\">Hi! This is Daoyu Wang, a Master student in Computer Science at State Key Laboratory of\n                Cognitive\n                Intelligence, University of Science and Technology of China (USTC). I am advised by Prof. <a\n                    href=\"http://staff.ustc.edu.cn/~qiliuql/\">Qi Liu</a> and Associate Researcher <a\n                    href=\"https://mingyue-cheng.github.io/\">Mingyue Cheng</a>.</p>\n            <p class=\"zh-text\">你好！我是王道宇，目前在中国科学技术大学认知智能全国重点实验室攻读计算机科学与技术硕士学位。我的导师是<a\n                    href=\"http://staff.ustc.edu.cn/~qiliuql/\">刘淇</a>教授和<a\n                    href=\"https://mingyue-cheng.github.io/\">程明月</a>副研究员。</p>\n        </section>",
  "research-interest": "<section id=\"research-interest\">\n            <h2>\n                <span class=\"en-text\">Research Interest</span>\n                <span class=\"zh-text\">研究兴趣</span>\n            </h2>\n            <p class=\"en-text\">My research focuses on <strong>LLM agents</strong>, with broader interests in\n                <strong>machine learning</strong>, <strong>agentic reinforcement learning</strong>, <strong>multimodal\n                    understanding and generation</strong>. My recent works explore:\n            </p>\n            <p class=\"zh-text\">\n                我的研究主要集中在<strong>大模型智能体</strong>，同时对<strong>机器学习</strong>、<strong>智能体强化学习</strong>和<strong>多模态理解与生成</strong>也有着广泛兴趣。我近期主要探索：\n            </p>\n            <ul class=\"en-text\">\n                <li>Agentic reasoning on scientific literature</li>\n                <li>Agentic reinforcement learning with LLMs</li>\n                <li>Retrieval-augmented generation with LLMs</li>\n            </ul>\n            <ul class=\"zh-text\">\n                <li>科技文献领域的智能体推理</li>\n                <li>大语言模型的智能体强化学习</li>\n                <li>大语言模型的检索增强生成</li>\n            </ul>\n        </section>",
  "awards": "<section id=\"awards\">\n            <h2>\n                <span class=\"en-text\">Awards</span>\n                <span class=\"zh-text\">荣誉奖项</span>\n            </h2>\n            <div class=\"award-item\">\n                <span class=\"award-year\">2026</span>\n                <div class=\"award-desc\">\n                    <strong class=\"en-text\">National Scholarship</strong>\n                    <strong class=\"zh-text\">国家奖学金</strong>\n                </div>\n            </div>\n            <div class=\"award-item\">\n                <span class=\"award-year\">2026</span>\n                <div class=\"award-desc\">\n                    <span class=\"en-text\">First-Class Graduate Academic Scholarship, USTC</span>\n                    <span class=\"zh-text\">中国科学技术大学 研究生学业奖学金一等奖</span>\n                </div>\n            </div>\n            <div class=\"award-item\">\n                <span class=\"award-year\">2025</span>\n                <div class=\"award-desc\">\n                    <span class=\"en-text\">First-Class Graduate Academic Scholarship, USTC</span>\n                    <span class=\"zh-text\">中国科学技术大学 研究生学业奖学金一等奖</span>\n                </div>\n            </div>\n            <div class=\"award-item\">\n                <span class=\"award-year\">2025</span>\n                <div class=\"award-desc\">\n                    <span class=\"en-text\">Outstanding Graduate, USTC</span>\n                    <span class=\"zh-text\">中国科学技术大学 优秀毕业生</span>\n                </div>\n            </div>\n            <div class=\"award-item\">\n                <span class=\"award-year\">2024</span>\n                <div class=\"award-desc\">\n                    <span class=\"en-text\">Meta KDD Cup 2024 CRAG Benchmark Silver Medal (Task 2 & 3)</span>\n                    <span class=\"zh-text\">Meta KDD Cup 2024 CRAG 挑战赛 银牌 (Task 2 & 3)</span>\n                </div>\n            </div>\n        </section>",
